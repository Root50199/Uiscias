# Normalize text to LF in the working tree (matches Prettier's endOfLine: lf),
# so generated config.json/config.yaml stay Prettier-stable regardless of
# core.autocrlf.
* text=auto eol=lf

# cmd.exe can mis-parse labels/goto in LF batch files; keep them CRLF.
*.bat text eol=crlf

# Packed mods, game assets, and the packer are binary — never line-ending normalize them.
*.exe binary
*.it binary
*.dds binary
*.pmg binary
*.rgn binary
*.area binary
*.set binary
*.raw binary
