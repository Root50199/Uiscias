{
  "name": "uiscias",
  "version": "1.43.0",
  "private": true,
  "description": "Mabinogi mod sources and maintainer scripts for Uiscias",
  "author": "Root50199",
  "license": "MIT",
  "scripts": {
    "mods": "tsx scripts/src/index.ts list",
    "changed": "tsx scripts/src/index.ts changed",
    "new-mod": "tsx scripts/src/index.ts new-mod",
    "new-mod-variant": "tsx scripts/src/index.ts new-mod --variant",
    "mabi-xml-edit": "tsx scripts/src/index.ts mabiXmlEdit",
    "generate-configs": "tsx scripts/src/index.ts generate-configs",
    "pack": "tsx scripts/src/index.ts pack",
    "build-manifest": "tsx scripts/src/index.ts build-manifest",
    "check": "tsx scripts/src/index.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.0",
    "@types/readline-sync": "^1.4.8",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "markdownlint": "^0.41.0",
    "markdownlint-cli2": "^0.23.0",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.4",
    "readline-sync": "^1.4.10",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,yml,yaml,css}": "prettier --write",
    "CHANGELOG.md": "prettier --write",
    "mods/**/README.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ],
    "docs/**/*.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ],
    "README.md": [
      "prettier --write",
      "markdownlint-cli2 --fix"
    ]
  }
}
