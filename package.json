{
  "name": "uiscias",
  "version": "1.14.0",
  "private": true,
  "description": "Mabinogi mod sources and maintainer scripts for Uiscias",
  "author": "Root50199",
  "license": "MIT",
  "scripts": {
    "mods": "tsx scripts/src/index.ts list",
    "changed": "tsx scripts/src/index.ts changed",
    "new-mod": "tsx scripts/src/index.ts new-mod",
    "generate-configs": "tsx scripts/src/index.ts generate-configs",
    "pack": "tsx scripts/src/index.ts pack",
    "build-manifest": "tsx scripts/src/index.ts build-manifest",
    "check": "tsx scripts/src/index.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.4",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml,css}": "prettier --write"
  }
}
